From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Fri, 27 Nov 2026 20:40:00 +1300
Subject: arm64: dts: rockchip: rk3576-armsom-cm5: add the Bluetooth
 node

The CM5 module carries a BW3752-50B1, a Broadcom BCM43752 combo chip.
Its Wi-Fi half is described on sdio, but UART4 is enabled with no
child, so hci_uart never probes the Bluetooth half.

Add the bluetooth node under uart4, wired as on the module schematic:
BT_REG_ON on GPIO1_C7, BT_WAKE (host to chip) on GPIO1_D4 and
BT_HOST_WAKE on GPIO0_B1. The LPO is the 32.768 kHz output of the
HYM8563, the same clock that sdio_pwrseq already hands to the Wi-Fi
side. VBAT comes from vcc_3v3_s3 and VDDIO from vcc_1v8_s3.

The chip reports itself as BCM4362A2, so btbcm loads
brcm/BCM4362A2.hcd. brcm,bcm43438-bt is the compatible the other
BCM43752 (AP6275S) boards use, as the binding has no 43752 entry.

Upstream: Pending
Signed-off-by: Jiaxing Hu <gahing@gahingwoo.com>
---
 arch/arm64/boot/dts/rockchip/rk3576-armsom-cm5.dtsi | 30 ++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-armsom-cm5.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-armsom-cm5.dtsi
index 111111111111..222222222222 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576-armsom-cm5.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3576-armsom-cm5.dtsi
@@ -570,6 +570,22 @@
 	pinctrl-names = "default";
 	uart-has-rtscts;
 	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm43438-bt";
+		clocks = <&hym8563>;
+		clock-names = "lpo";
+		device-wakeup-gpios = <&gpio1 RK_PD4 GPIO_ACTIVE_HIGH>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PB1 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "host-wakeup";
+		max-speed = <1500000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_host_wake_h &bt_reg_on_h &bt_wake_h>;
+		shutdown-gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_HIGH>;
+		vbat-supply = <&vcc_3v3_s3>;
+		vddio-supply = <&vcc_1v8_s3>;
+	};
 };
 
 &pinctrl {
@@ -579,6 +595,20 @@
 		};
 	};
 
+	wireless-bluetooth {
+		bt_host_wake_h: bt-host-wake-h {
+			rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+
+		bt_reg_on_h: bt-reg-on-h {
+			rockchip,pins = <1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		bt_wake_h: bt-wake-h {
+			rockchip,pins = <1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
 	wireless-wlan {
 		/* GPIO1 PC6 - WiFi power enable / reset (sdio_pwrseq) */
 		wifi_reg_on: wifi-reg-on {
-- 
