From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Sun, 1 Nov 2026 18:00:00 +1300
Subject: DEBUG: print QoS after restore (not for upstream)

---
diff --git a/drivers/pmdomain/rockchip/pm-domains.c b/drivers/pmdomain/rockchip/pm-domains.c
index 111111111111..222222222222 100644
--- a/drivers/pmdomain/rockchip/pm-domains.c
+++ b/drivers/pmdomain/rockchip/pm-domains.c
@@ -682,6 +682,20 @@ static int rockchip_pd_power(struct rockchip_pm_domain *pd, bool power_on)
 			goto out;
 
 		rockchip_pmu_restore_qos(pd);
+		{
+			int qi;
+			u32 v[5];
+
+			for (qi = 0; qi < pd->num_qos; qi++) {
+				regmap_read(pd->qos_regmap[qi], QOS_PRIORITY, &v[0]);
+				regmap_read(pd->qos_regmap[qi], QOS_MODE, &v[1]);
+				regmap_read(pd->qos_regmap[qi], QOS_BANDWIDTH, &v[2]);
+				regmap_read(pd->qos_regmap[qi], QOS_SATURATION, &v[3]);
+				regmap_read(pd->qos_regmap[qi], QOS_EXTCONTROL, &v[4]);
+				dev_info(pmu->dev, "QOSDBG %s qos%d now %08x %08x %08x %08x %08x\n",
+					 pd->genpd.name, qi, v[0], v[1], v[2], v[3], v[4]);
+			}
+		}
 	}
 
 out:
